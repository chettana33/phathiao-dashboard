rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // dashboard_notes: กระดานไอเดียกลาง — อ่านได้ทุกคน · เพิ่มได้ · แก้/ลบต้องทำในคอนโซล
    match /dashboard_notes/{noteId} {
      allow read: if true;
      allow create: if request.resource.data.text is string
                    && request.resource.data.text.size() >= 1
                    && request.resource.data.text.size() <= 2000
                    && request.resource.data.created is timestamp
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 100;
      allow update, delete: if false;
    }

    // card_notes: โน้ต/ฝากข้อความต่อ "การ์ดงาน" ในหน้าแผนที่งาน (เพิ่ม 14 ต.ค. 69 · เฟส 2)
    // อ่านได้ทุกคน (กระดานเดียวกัน) · เพิ่มได้ · แก้/ลบต้องทำในคอนโซล เพื่อกันข้อความถูกแก้ย้อนหลัง
    match /card_notes/{noteId} {
      allow read: if true;
      allow create: if request.resource.data.card is string
                    && request.resource.data.card.size() >= 3
                    && request.resource.data.card.size() <= 20
                    && request.resource.data.text is string
                    && request.resource.data.text.size() >= 1
                    && request.resource.data.text.size() <= 2000
                    && request.resource.data.created is timestamp
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 100;
      allow update, delete: if false;
    }

    // dashboard_state: สถานะสดของกระดาน (ตัวเลขงานค้างต่อการ์ด ฯลฯ) — เขียนโดยสคริปต์ของพาเที่ยว
    // อ่านได้ทุกคน · สร้างได้ (ต้องมีฟิลด์ครบ + ขนาดจำกัด) · แก้/ลบต้องทำในคอนโซล
    match /dashboard_state/{docId} {
      allow read: if true;
      allow create: if request.resource.data.updatedAt is timestamp
                    && request.resource.data.source is string
                    && request.resource.data.source.size() <= 40
                    && request.resource.data.payload is string
                    && request.resource.data.payload.size() <= 200000;
      allow update, delete: if false;
    }
  }
}
