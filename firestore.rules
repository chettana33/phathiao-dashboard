rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // เจ้าของกระดาน (อนุญาตเฉพาะบัญชีของพี่เจ) — ใช้กับข้อมูลที่ไม่ขึ้นสาธารณะ
    function isOwner() {
      return request.auth != null
             && request.auth.token.email_verified == true
             && request.auth.token.email in ['kimonoland.jp1@gmail.com', 'chettana33@gmail.com'];
    }

    // dashboard_notes: กระดานไอเดียกลาง — อ่านได้ทุกคน · เพิ่มได้ · แก้/ลบต้องทำในคอนโซล
    match /dashboard_notes/{noteId} {
      allow read: if true;
      allow create: if request.resource.data.text is string
                    && request.resource.data.text.size() >= 1
                    && request.resource.data.text.size() <= 2000
                    && request.resource.data.created is timestamp
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 100;
      allow update, delete: if false;
    }

    // card_notes: โน้ต/ฝากข้อความต่อ "การ์ดงาน" ในหน้าแผนที่งาน (เพิ่ม 14 ต.ค. 69 · เฟส 2)
    // อ่านได้ทุกคน (กระดานเดียวกัน) · เพิ่มได้ · แก้/ลบต้องทำในคอนโซล เพื่อกันข้อความถูกแก้ย้อนหลัง
    match /card_notes/{noteId} {
      allow read: if true;
      allow create: if request.resource.data.card is string
                    && request.resource.data.card.size() >= 3
                    && request.resource.data.card.size() <= 20
                    && request.resource.data.text is string
                    && request.resource.data.text.size() >= 1
                    && request.resource.data.text.size() <= 2000
                    && request.resource.data.created is timestamp
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 100;
      allow update, delete: if false;
    }

    // dashboard_state: สถานะสดของกระดาน (ตัวเลขงานค้างต่อการ์ด ฯลฯ) — เขียนโดยสคริปต์ของพาเที่ยว
    // อ่านได้ทุกคน · สร้างได้ (ต้องมีฟิลด์ครบ + ขนาดจำกัด) · แก้/ลบต้องทำในคอนโซล
    match /dashboard_state/{docId} {
      allow read: if true;
      allow create: if request.resource.data.updatedAt is timestamp
                    && request.resource.data.source is string
                    && request.resource.data.source.size() <= 40
                    && request.resource.data.payload is string
                    && request.resource.data.payload.size() <= 200000;
      allow update, delete: if false;
    }

    // private_digest: บรรทัดที่ "ถูกกันออก" จากหน้าเว็บสาธารณะ (กรองจาก checkpoint/memory)
    // ⇒ พี่เจยังเห็นครบเมื่อล็อกอิน · คนอื่นอ่านไม่ได้เลย
    // เขียนโดยสคริปต์ของพาเที่ยว (ไม่มี auth เหมือน dashboard_state) ⇒ เปิด create แต่ปิด read ให้เจ้าของเท่านั้น
    match /private_digest/{docId} {
      allow read: if isOwner();
      allow create: if request.resource.data.updatedAt is timestamp
                    && request.resource.data.updatedAt <= request.time
                    && request.resource.data.source is string
                    && request.resource.data.source.size() <= 40
                    && request.resource.data.payload is string
                    && request.resource.data.payload.size() <= 200000;
      allow update, delete: if false;
    }

    // private_notes: โน้ตส่วนตัวของพี่เจ — อ่าน/เพิ่มได้เฉพาะบัญชีที่อนุญาต (ต้องล็อกอิน)
    // คนอื่น (รวมคนที่ไม่ได้ล็อกอิน) อ่านไม่ได้เลย ⇒ ข้อมูลไม่รั่วแม้ URL เว็บเป็นสาธารณะ
    match /private_notes/{noteId} {
      allow read: if isOwner();
      allow create: if isOwner()
                    && request.resource.data.text is string
                    && request.resource.data.text.size() >= 1
                    && request.resource.data.text.size() <= 5000
                    && request.resource.data.created is timestamp
                    && request.resource.data.email is string;
      allow update, delete: if false;
    }
  }
}
